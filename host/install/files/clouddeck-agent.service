# Installed by CloudDeck-Client host/install/install.sh
# (docs/adr/0006-usb-passthrough.md, docs/adr/0007-multi-monitor.md).
[Unit]
Description=CloudDeck-Client host agent (USB passthrough, display matching)
After=local-fs.target

[Service]
# CDC_SOCKET_GROUP = the desktop user's group (Sunshine runs as that user)
# CDC_DESKTOP_USER = the user owning the Plasma session (kscreen-doctor runs as them)
EnvironmentFile=/etc/clouddeck-client/agent.env
ExecStart=/var/opt/clouddeck-client/bin/clouddeck-agent -group ${CDC_SOCKET_GROUP} -desktop-user ${CDC_DESKTOP_USER}
Restart=on-failure
RestartSec=2
# Root is required for vhci_hcd sysfs writes and modprobe; restrict the rest.
# /run/user stays reachable read-only so kscreen-doctor (run as the desktop user)
# can reach the Wayland socket. The display state lives in /var/lib/clouddeck-client.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/run

[Install]
WantedBy=multi-user.target
