--- /dev/null
+++ b/tests/unit/test_clouddeck_tunnel.cpp
@@ -0,0 +1,31 @@
+/**
+ * @file tests/unit/test_clouddeck_tunnel.cpp
+ * @brief Test src/clouddeck_tunnel.* (CloudDeck-Client agent tunnel).
+ */
+#include "../tests_common.h"
+
+#include <src/clouddeck_tunnel.h>
+
+TEST(CloudDeckTunnelTest, ValidPaths) {
+  EXPECT_TRUE(clouddeck_tunnel::valid_path("/clouddeck/v1/hello"));
+  EXPECT_TRUE(clouddeck_tunnel::valid_path("/clouddeck/v1/usb/attach"));
+  EXPECT_FALSE(clouddeck_tunnel::valid_path("/clouddeck/v2/hello"));
+  EXPECT_FALSE(clouddeck_tunnel::valid_path("/serverinfo"));
+  EXPECT_FALSE(clouddeck_tunnel::valid_path("/clouddeck/v1/../../etc"));
+  EXPECT_FALSE(clouddeck_tunnel::valid_path("/clouddeck/v1/a b"));
+  EXPECT_FALSE(clouddeck_tunnel::valid_path("/clouddeck/v1/x\n"));
+  EXPECT_FALSE(clouddeck_tunnel::valid_path("/clouddeck/v1/" + std::string(200, 'a')));
+}
+
+TEST(CloudDeckTunnelTest, HeaderLine) {
+  const std::string fp(64, 'a');
+  EXPECT_EQ(clouddeck_tunnel::header_line(fp, "/clouddeck/v1/hello", ""), "CDC1 " + fp + " /clouddeck/v1/hello\n");
+  EXPECT_EQ(clouddeck_tunnel::header_line(fp, "/clouddeck/v1/usb/attach", "busid=1-2"),
+            "CDC1 " + fp + " /clouddeck/v1/usb/attach?busid=1-2\n");
+}
+
+TEST(CloudDeckTunnelTest, AgentSocketDefault) {
+  if (!std::getenv("CLOUDDECK_AGENT_SOCKET")) {
+    EXPECT_EQ(clouddeck_tunnel::agent_socket_path(), "/run/clouddeck-client/agent.sock");
+  }
+}
