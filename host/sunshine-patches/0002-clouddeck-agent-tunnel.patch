new file mode 100644
index 0000000..3eda590
--- /dev/null
+++ b/src/clouddeck_tunnel.cpp
@@ -0,0 +1,261 @@
+/**
+ * @file src/clouddeck_tunnel.cpp
+ * @brief CloudDeck-Client: HTTPS upgrade tunnel to the host agent (see header).
+ */
+#include "clouddeck_tunnel.h"
+
+#include <array>
+#include <cctype>
+#include <cstdlib>
+#include <format>
+
+#include <boost/asio/bind_executor.hpp>
+#include <boost/asio/buffers_iterator.hpp>
+#include <boost/asio/local/stream_protocol.hpp>
+#include <boost/asio/read_until.hpp>
+#include <boost/asio/strand.hpp>
+#include <boost/asio/streambuf.hpp>
+#include <boost/asio/write.hpp>
+#include <openssl/evp.h>
+#include <openssl/x509.h>
+
+#include "logging.h"
+#include "nvhttp.h"
+
+using namespace std::literals;
+
+namespace clouddeck_tunnel {
+  namespace asio = boost::asio;
+  using error_code = boost::system::error_code;
+
+  std::string agent_socket_path() {
+    const char *p = std::getenv("CLOUDDECK_AGENT_SOCKET");
+    return p && *p ? p : "/run/clouddeck-client/agent.sock";
+  }
+
+  bool valid_path(const std::string &path) {
+    if (path.rfind("/clouddeck/v1/", 0) != 0 || path.size() > 128) {
+      return false;
+    }
+    for (char c : path) {
+      if (!(std::isalnum((unsigned char) c) || c == '/' || c == '_' || c == '-' || c == '.')) {
+        return false;
+      }
+    }
+    return path.find("..") == std::string::npos;
+  }
+
+  std::string header_line(const std::string &fingerprint, const std::string &path, const std::string &query) {
+    std::string target = path;
+    if (!query.empty()) {
+      target += "?" + query;
+    }
+    return "CDC1 " + fingerprint + " " + target + "\n";
+  }
+
+  std::string peer_fingerprint(SSL *ssl) {
+#if OPENSSL_VERSION_MAJOR >= 3
+    X509 *cert = SSL_get1_peer_certificate(ssl);
+#else
+    X509 *cert = SSL_get_peer_certificate(ssl);
+#endif
+    if (!cert) {
+      return {};
+    }
+    unsigned char md[EVP_MAX_MD_SIZE];
+    unsigned int n = 0;
+    const bool ok = X509_digest(cert, EVP_sha256(), md, &n) == 1;
+    X509_free(cert);
+    if (!ok) {
+      return {};
+    }
+    static const char *hex = "0123456789abcdef";
+    std::string out;
+    for (unsigned int i = 0; i < n; i++) {
+      out.push_back(hex[md[i] >> 4]);
+      out.push_back(hex[md[i] & 15]);
+    }
+    return out;
+  }
+
+  namespace {
+    const char *reason(int status) {
+      switch (status) {
+        case 200:
+          return "OK";
+        case 403:
+          return "Forbidden";
+        case 404:
+          return "Not Found";
+        case 502:
+          return "Bad Gateway";
+        default:
+          return "Service Unavailable";
+      }
+    }
+
+    std::string http_response(int status, const std::string &body, const std::string &content_type) {
+      return std::format("HTTP/1.1 {} {}\r\nContent-Type: {}\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}", status, reason(status), content_type, body.size(), body);
+    }
+
+    class tunnel_t: public std::enable_shared_from_this<tunnel_t> {
+    public:
+      tunnel_t(std::unique_ptr<nvhttp::SunshineHTTPS> tls, std::string header):
+          tls_(std::move(tls)),
+          strand_(asio::make_strand(tls_->get_executor())),
+          agent_(strand_),
+          header_(std::move(header)) {}
+
+      void start() {
+        auto self = shared_from_this();
+        agent_.async_connect(asio::local::stream_protocol::endpoint(agent_socket_path()), asio::bind_executor(strand_, [this, self](const error_code &ec) {
+                               if (ec) {
+                                 respond(503, "CloudDeck host agent is not running\n", "text/plain");
+                                 return;
+                               }
+                               asio::async_write(agent_, asio::buffer(header_), asio::bind_executor(strand_, [this, self](const error_code &ec, std::size_t) {
+                                                   if (ec) {
+                                                     respond(502, "agent write failed\n", "text/plain");
+                                                     return;
+                                                   }
+                                                   read_agent_reply();
+                                                 }));
+                             }));
+      }
+
+    private:
+      void read_agent_reply() {
+        auto self = shared_from_this();
+        asio::async_read_until(agent_, agent_buf_, '\n', asio::bind_executor(strand_, [this, self](const error_code &ec, std::size_t n) {
+                                 if (ec) {
+                                   respond(502, "agent closed the connection\n", "text/plain");
+                                   return;
+                                 }
+                                 std::string line {asio::buffers_begin(agent_buf_.data()), asio::buffers_begin(agent_buf_.data()) + (std::ptrdiff_t) n};
+                                 agent_buf_.consume(n);
+                                 while (!line.empty() && (line.back() == '\n' || line.back() == '\r')) {
+                                   line.pop_back();
+                                 }
+                                 if (line == "OK") {
+                                   switch_protocols();
+                                 } else if (line.rfind("OK ", 0) == 0) {
+                                   respond(200, line.substr(3), "application/json");
+                                 } else {
+                                   respond(502, (line.rfind("ERR ", 0) == 0 ? line.substr(4) : line) + "\n", "text/plain");
+                                 }
+                               }));
+      }
+
+      void respond(int status, const std::string &body, const std::string &content_type) {
+        auto self = shared_from_this();
+        out_ = http_response(status, body, content_type);
+        asio::async_write(*tls_, asio::buffer(out_), asio::bind_executor(strand_, [this, self](const error_code &, std::size_t) {
+                            close();
+                          }));
+      }
+
+      void switch_protocols() {
+        auto self = shared_from_this();
+        out_ = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: clouddeck-agent/1\r\nConnection: Upgrade\r\n\r\n";
+        asio::async_write(*tls_, asio::buffer(out_), asio::bind_executor(strand_, [this, self](const error_code &ec, std::size_t) {
+                            if (ec) {
+                              close();
+                              return;
+                            }
+                            // Forward anything the agent already sent after its OK line.
+                            if (agent_buf_.size()) {
+                              asio::async_write(*tls_, agent_buf_.data(), asio::bind_executor(strand_, [this, self](const error_code &ec, std::size_t n) {
+                                                  agent_buf_.consume(n);
+                                                  if (ec) {
+                                                    close();
+                                                    return;
+                                                  }
+                                                  pump_up();
+                                                  pump_down();
+                                                }));
+                              return;
+                            }
+                            pump_up();
+                            pump_down();
+                          }));
+      }
+
+      // client (TLS) -> agent
+      void pump_up() {
+        auto self = shared_from_this();
+        tls_->async_read_some(asio::buffer(up_), asio::bind_executor(strand_, [this, self](const error_code &ec, std::size_t n) {
+                                if (ec) {
+                                  close();
+                                  return;
+                                }
+                                asio::async_write(agent_, asio::buffer(up_, n), asio::bind_executor(strand_, [this, self](const error_code &ec, std::size_t) {
+                                                    if (ec) {
+                                                      close();
+                                                      return;
+                                                    }
+                                                    pump_up();
+                                                  }));
+                              }));
+      }
+
+      // agent -> client (TLS)
+      void pump_down() {
+        auto self = shared_from_this();
+        agent_.async_read_some(asio::buffer(down_), asio::bind_executor(strand_, [this, self](const error_code &ec, std::size_t n) {
+                                 if (ec) {
+                                   close();
+                                   return;
+                                 }
+                                 asio::async_write(*tls_, asio::buffer(down_, n), asio::bind_executor(strand_, [this, self](const error_code &ec, std::size_t) {
+                                                     if (ec) {
+                                                       close();
+                                                       return;
+                                                     }
+                                                     pump_down();
+                                                   }));
+                               }));
+      }
+
+      void close() {
+        if (closed_) {
+          return;
+        }
+        closed_ = true;
+        error_code ec;
+        agent_.close(ec);
+        tls_->lowest_layer().shutdown(asio::ip::tcp::socket::shutdown_both, ec);
+        tls_->lowest_layer().close(ec);
+      }
+
+      std::unique_ptr<nvhttp::SunshineHTTPS> tls_;
+      asio::strand<asio::any_io_executor> strand_;
+      asio::local::stream_protocol::socket agent_;
+      std::string header_;
+      std::string out_;
+      asio::streambuf agent_buf_;
+      std::array<char, 16384> up_ {};
+      std::array<char, 16384> down_ {};
+      bool closed_ = false;
+    };
+  }  // namespace
+
+  void handle_upgrade(std::unique_ptr<nvhttp::SunshineHTTPS> &socket, const std::string &path, const std::string &query) {
+    error_code ec;
+    if (!valid_path(path)) {
+      // Not ours (e.g. another client trying an Upgrade): plain 404, then close.
+      auto resp = http_response(404, "Not Found\n", "text/plain");
+      asio::write(*socket, asio::buffer(resp), ec);
+      return;
+    }
+    // The HTTPS server only reads requests after Sunshine's verify callback accepted
+    // the client certificate, so this peer is a paired, enabled client.
+    auto fingerprint = peer_fingerprint(socket->native_handle());
+    if (fingerprint.empty()) {
+      auto resp = http_response(403, "Forbidden\n", "text/plain");
+      asio::write(*socket, asio::buffer(resp), ec);
+      return;
+    }
+    BOOST_LOG(debug) << "clouddeck_tunnel: "sv << path << " for client "sv << fingerprint.substr(0, 12);
+    std::make_shared<tunnel_t>(std::move(socket), header_line(fingerprint, path, query))->start();
+  }
+}  // namespace clouddeck_tunnel
diff --git a/src/clouddeck_tunnel.h b/src/clouddeck_tunnel.h
new file mode 100644
index 0000000..3e143ef
--- /dev/null
+++ b/src/clouddeck_tunnel.h
@@ -0,0 +1,39 @@
+/**
+ * @file src/clouddeck_tunnel.h
+ * @brief CloudDeck-Client: tunnel from Sunshine's HTTPS server (paired clients only)
+ *        to the host agent's Unix socket. Spec: CloudDeck-Client docs/adr/0006.
+ *
+ * Client:  GET /clouddeck/v1/<op>[?query]  with  "Upgrade: clouddeck-agent/1"
+ * Sunshine -> agent:  "CDC1 <sha256(client cert DER) hex> <path?query>\n"
+ * agent -> Sunshine:  "OK\n"         => 101 Switching Protocols, then raw relay
+ *                     "OK <json>\n"  => 200 with the JSON body
+ *                     "ERR <msg>\n"  => 502
+ * No agent socket   =>                 503
+ */
+#pragma once
+
+#include <memory>
+#include <string>
+
+#include <openssl/ssl.h>
+
+namespace nvhttp {
+  class SunshineHTTPS;
+}
+
+namespace clouddeck_tunnel {
+  /// Default agent socket, overridable with CLOUDDECK_AGENT_SOCKET.
+  std::string agent_socket_path();
+
+  /// True for paths this tunnel serves ("/clouddeck/v1/..." with safe characters only).
+  bool valid_path(const std::string &path);
+
+  /// The header line sent to the agent.
+  std::string header_line(const std::string &fingerprint, const std::string &path, const std::string &query);
+
+  /// SHA-256 fingerprint (lowercase hex) of the TLS peer certificate, empty if none.
+  std::string peer_fingerprint(SSL *ssl);
+
+  /// on_upgrade handler for the HTTPS server. Takes ownership of the socket.
+  void handle_upgrade(std::unique_ptr<nvhttp::SunshineHTTPS> &socket, const std::string &path, const std::string &query);
+}  // namespace clouddeck_tunnel
