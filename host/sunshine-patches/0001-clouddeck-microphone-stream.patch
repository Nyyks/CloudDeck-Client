@@ -0,0 +1,71 @@
+/**
+ * @file src/clouddeck_mic.h
+ * @brief CloudDeck-Client microphone stream (client -> host), protocol v1.
+ *
+ * Opus audio from the client, AES-GCM encrypted with the session key, arriving on
+ * the existing audio UDP port. Decoded audio goes into a virtual PulseAudio/PipeWire
+ * source "clouddeck-mic" ("CloudDeck Microphone").
+ * Wire format: CloudDeck-Client docs/protocol-extensions.md, section 1.
+ */
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "crypto.h"
+
+namespace clouddeck_mic {
+  constexpr std::uint8_t PACKET_TYPE = 0x8D;
+  constexpr std::uint8_t PACKET_VERSION = 1;
+  constexpr std::size_t HEADER_SIZE = 28;  ///< type, version, reserved[2], sessionTag[16], seq[8]
+  constexpr std::size_t TAG_SIZE = 16;
+  constexpr std::size_t INNER_SIZE = 6;  ///< encrypted flags (u16) + rtpTs (u32)
+  constexpr std::size_t MAX_OPUS_SIZE = 1200;
+  constexpr std::size_t MIN_PACKET_SIZE = HEADER_SIZE + TAG_SIZE + INNER_SIZE + 1;
+  constexpr int SAMPLE_RATE = 48000;
+
+  /// True if this host advertises the mic extension (disable with CLOUDDECK_MIC=0).
+  bool enabled();
+
+  /// Cheap check used by the UDP receive loop on the audio socket.
+  bool is_mic_packet(const char *data, std::size_t len);
+
+  struct decoded_t {
+    std::uint64_t seq;
+    std::uint32_t rtp_ts;
+    std::uint16_t flags;
+    std::vector<std::uint8_t> opus;
+  };
+
+  /// 12-byte nonce: LE64(seq) || 00 00 || 'C' 'M'.
+  crypto::aes_t nonce_for(std::uint64_t seq);
+
+  /// Verifies and decrypts one packet (no replay check). Empty on any failure.
+  std::optional<decoded_t> decode_packet(crypto::cipher::gcm_t &cipher, std::string_view packet);
+
+  /// 64-entry sliding replay window. accept() returns false for duplicates/too old.
+  class replay_window_t {
+  public:
+    bool accept(std::uint64_t seq);
+
+  private:
+    bool any_ = false;
+    std::uint64_t highest_ = 0;
+    std::uint64_t bitmap_ = 0;
+  };
+
+  struct receiver_t;
+
+  /// Created for a session whose ANNOUNCE requested the mic.
+  std::shared_ptr<receiver_t> make_receiver(const crypto::aes_t &key, const std::string &session_tag);
+  /// Starts accepting packets for the receiver's session tag.
+  void activate(const std::shared_ptr<receiver_t> &receiver);
+  /// Stops accepting packets and joins the writer thread.
+  void deactivate(const std::shared_ptr<receiver_t> &receiver);
+  /// Routes a mic packet (already checked with is_mic_packet) to its session.
+  void dispatch(const char *data, std::size_t len);
+}  // namespace clouddeck_mic
