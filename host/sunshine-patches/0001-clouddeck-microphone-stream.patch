--- /dev/null
+++ b/src/clouddeck_mic.cpp
@@ -0,0 +1,367 @@
+/**
+ * @file src/clouddeck_mic.cpp
+ * @brief CloudDeck-Client microphone stream (see clouddeck_mic.h).
+ */
+#include "clouddeck_mic.h"
+
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <map>
+#include <mutex>
+#include <thread>
+
+#include <opus/opus.h>
+
+#include "logging.h"
+
+#ifdef __linux__
+  #include <pulse/error.h>
+  #include <pulse/simple.h>
+#endif
+
+using namespace std::literals;
+
+namespace clouddeck_mic {
+  namespace {
+    constexpr auto SINK_NAME = "sink-clouddeck-mic";
+    constexpr auto SOURCE_NAME = "clouddeck-mic";
+    constexpr int FRAME_MAX = 5760;  // 120 ms at 48 kHz, Opus maximum
+    constexpr std::size_t QUEUE_MAX = 25;  // 500 ms of 20 ms frames
+    constexpr std::uint64_t MAX_LATENCY_US = 150000;
+
+    std::uint64_t be64(const std::uint8_t *p) {
+      std::uint64_t v = 0;
+      for (int i = 0; i < 8; i++) {
+        v = (v << 8) | p[i];
+      }
+      return v;
+    }
+
+#ifdef __linux__
+    /// Runs a pactl command and returns its stdout (trimmed), or nullopt on failure.
+    std::optional<std::string> pactl(const std::string &args) {
+      std::string cmd = "pactl " + args + " 2>/dev/null";
+      FILE *p = popen(cmd.c_str(), "r");
+      if (!p) {
+        return std::nullopt;
+      }
+      std::string out;
+      char buf[256];
+      while (fgets(buf, sizeof(buf), p)) {
+        out += buf;
+      }
+      if (pclose(p) != 0) {
+        return std::nullopt;
+      }
+      while (!out.empty() && (out.back() == '\n' || out.back() == ' ')) {
+        out.pop_back();
+      }
+      return out;
+    }
+
+    /// Creates the virtual microphone once; it then persists for the PipeWire session.
+    bool ensure_virtual_mic() {
+      static std::mutex m;
+      std::lock_guard lg {m};
+      auto sinks = pactl("list short sinks");
+      if (sinks && sinks->find(SINK_NAME) == std::string::npos) {
+        if (!pactl("load-module module-null-sink sink_name="s + SINK_NAME +
+                   " rate=48000 channels=1 channel_map=mono"
+                   " \"sink_properties=device.description='CloudDeck Mic (internal)'\"")) {
+          BOOST_LOG(error) << "clouddeck_mic: could not create "sv << SINK_NAME;
+          return false;
+        }
+      }
+      auto sources = pactl("list short sources");
+      if (sources && sources->find(std::string(SOURCE_NAME) + "\t") == std::string::npos) {
+        if (!pactl("load-module module-remap-source master="s + SINK_NAME + ".monitor source_name=" + SOURCE_NAME +
+                   " rate=48000 channels=1 channel_map=mono"
+                   " \"source_properties=device.description='CloudDeck Microphone'\"")) {
+          BOOST_LOG(error) << "clouddeck_mic: could not create "sv << SOURCE_NAME;
+          return false;
+        }
+        BOOST_LOG(info) << "clouddeck_mic: created virtual microphone \"CloudDeck Microphone\""sv;
+      }
+      return sinks.has_value() && sources.has_value();
+    }
+
+    class sink_t {
+    public:
+      ~sink_t() {
+        close();
+      }
+
+      bool open() {
+        if (pa) {
+          return true;
+        }
+        if (!ensure_virtual_mic()) {
+          return false;
+        }
+        pa_sample_spec spec {PA_SAMPLE_S16LE, SAMPLE_RATE, 1};
+        pa_buffer_attr attr {};
+        attr.maxlength = (std::uint32_t) -1;
+        attr.tlength = SAMPLE_RATE * 2 * 60 / 1000;  // 60 ms target
+        attr.prebuf = SAMPLE_RATE * 2 * 20 / 1000;  // start after one frame
+        attr.minreq = (std::uint32_t) -1;
+        attr.fragsize = (std::uint32_t) -1;
+        int err = 0;
+        pa = pa_simple_new(nullptr, "Sunshine", PA_STREAM_PLAYBACK, SINK_NAME, "CloudDeck microphone", &spec, nullptr, &attr, &err);
+        if (!pa) {
+          BOOST_LOG(error) << "clouddeck_mic: pa_simple_new failed: "sv << pa_strerror(err);
+          return false;
+        }
+        return true;
+      }
+
+      void write(const std::int16_t *pcm, int samples) {
+        if (!pa && !open()) {
+          return;
+        }
+        int err = 0;
+        // Bound latency against clock drift: drop the frame if we're too far behind.
+        pa_usec_t latency = pa_simple_get_latency(pa, &err);
+        if (latency != (pa_usec_t) -1 && latency > MAX_LATENCY_US) {
+          return;
+        }
+        if (pa_simple_write(pa, pcm, samples * sizeof(std::int16_t), &err) < 0) {
+          BOOST_LOG(warning) << "clouddeck_mic: write failed: "sv << pa_strerror(err) << ", reopening"sv;
+          close();
+        }
+      }
+
+      void close() {
+        if (pa) {
+          pa_simple_free(pa);
+          pa = nullptr;
+        }
+      }
+
+    private:
+      pa_simple *pa = nullptr;
+    };
+#else
+    class sink_t {
+    public:
+      bool open() {
+        return false;
+      }
+
+      void write(const std::int16_t *, int) {}
+
+      void close() {}
+    };
+#endif
+  }  // namespace
+
+  bool enabled() {
+#ifdef __linux__
+    const char *e = std::getenv("CLOUDDECK_MIC");
+    return !(e && std::string_view {e} == "0");
+#else
+    return false;
+#endif
+  }
+
+  bool is_mic_packet(const char *data, std::size_t len) {
+    return len >= MIN_PACKET_SIZE && (std::uint8_t) data[0] == PACKET_TYPE;
+  }
+
+  crypto::aes_t nonce_for(std::uint64_t seq) {
+    crypto::aes_t iv(12, 0);
+    for (int i = 0; i < 8; i++) {
+      iv[i] = (std::uint8_t) (seq >> (8 * i));
+    }
+    iv[10] = 'C';  // client originated
+    iv[11] = 'M';  // microphone
+    return iv;
+  }
+
+  std::optional<decoded_t> decode_packet(crypto::cipher::gcm_t &cipher, std::string_view packet) {
+    auto p = (const std::uint8_t *) packet.data();
+    if (packet.size() < MIN_PACKET_SIZE || packet.size() > HEADER_SIZE + TAG_SIZE + INNER_SIZE + MAX_OPUS_SIZE ||
+        p[0] != PACKET_TYPE || p[1] != PACKET_VERSION) {
+      return std::nullopt;
+    }
+    decoded_t d;
+    d.seq = be64(&p[20]);
+    auto iv = nonce_for(d.seq);
+    std::vector<std::uint8_t> plain;
+    // tagged_cipher = tag || ciphertext, exactly as gcm_t expects
+    if (cipher.decrypt(packet.substr(HEADER_SIZE), plain, &iv) != 0 || plain.size() < INNER_SIZE + 1) {
+      return std::nullopt;
+    }
+    d.flags = (std::uint16_t) ((plain[0] << 8) | plain[1]);
+    d.rtp_ts = ((std::uint32_t) plain[2] << 24) | ((std::uint32_t) plain[3] << 16) | ((std::uint32_t) plain[4] << 8) | plain[5];
+    d.opus.assign(plain.begin() + INNER_SIZE, plain.end());
+    return d;
+  }
+
+  bool replay_window_t::accept(std::uint64_t seq) {
+    if (!any_) {
+      any_ = true;
+      highest_ = seq;
+      bitmap_ = 1;
+      return true;
+    }
+    if (seq > highest_) {
+      auto shift = seq - highest_;
+      bitmap_ = shift >= 64 ? 1 : (bitmap_ << shift) | 1;
+      highest_ = seq;
+      return true;
+    }
+    auto age = highest_ - seq;
+    if (age >= 64) {
+      return false;  // too old
+    }
+    auto bit = std::uint64_t {1} << age;
+    if (bitmap_ & bit) {
+      return false;  // duplicate
+    }
+    bitmap_ |= bit;
+    return true;
+  }
+
+  struct receiver_t {
+    receiver_t(const crypto::aes_t &key, std::string tag):
+        cipher {key, false},
+        session_tag {std::move(tag)} {}
+
+    crypto::cipher::gcm_t cipher;  // only used from the UDP receive thread
+    std::string session_tag;
+    replay_window_t window;
+    std::uint64_t dropped = 0;
+
+    std::mutex lock;
+    std::condition_variable cv;
+    std::deque<decoded_t> queue;
+    bool running = false;
+    std::thread writer;
+
+    void handle(std::string_view packet) {
+      auto d = decode_packet(cipher, packet);
+      if (!d || !window.accept(d->seq)) {
+        if ((++dropped % 100) == 1) {
+          BOOST_LOG(debug) << "clouddeck_mic: dropped invalid/replayed packet(s): "sv << dropped;
+        }
+        return;
+      }
+      std::lock_guard lg {lock};
+      if (queue.size() >= QUEUE_MAX) {
+        queue.pop_front();  // writer is behind; keep the freshest audio
+      }
+      queue.push_back(std::move(*d));
+      cv.notify_one();
+    }
+
+    void run() {
+      int err = 0;
+      OpusDecoder *dec = opus_decoder_create(SAMPLE_RATE, 1, &err);
+      if (!dec) {
+        BOOST_LOG(error) << "clouddeck_mic: opus_decoder_create failed: "sv << err;
+        return;
+      }
+      sink_t sink;
+      sink.open();
+      std::vector<std::int16_t> pcm(FRAME_MAX);
+      std::optional<std::uint64_t> last_seq;
+
+      std::unique_lock ul {lock};
+      while (running) {
+        cv.wait_for(ul, 100ms, [this]() { return !queue.empty() || !running; });
+        while (!queue.empty() && running) {
+          auto d = std::move(queue.front());
+          queue.pop_front();
+          ul.unlock();
+
+          // One packet lost: let Opus rebuild it from the FEC data in this packet.
+          if (last_seq && d.seq == *last_seq + 2) {
+            int n = opus_decode(dec, d.opus.data(), (opus_int32) d.opus.size(), pcm.data(), 960, 1);
+            if (n > 0) {
+              sink.write(pcm.data(), n);
+            }
+          }
+          if (!last_seq || d.seq > *last_seq) {
+            int n = opus_decode(dec, d.opus.data(), (opus_int32) d.opus.size(), pcm.data(), FRAME_MAX, 0);
+            if (n > 0) {
+              sink.write(pcm.data(), n);
+            }
+            last_seq = d.seq;
+          }
+          ul.lock();
+        }
+      }
+      ul.unlock();
+      sink.close();
+      opus_decoder_destroy(dec);
+    }
+  };
+
+  namespace {
+    std::mutex registry_lock;
+    std::map<std::string, std::shared_ptr<receiver_t>> registry;
+  }  // namespace
+
+  std::shared_ptr<receiver_t> make_receiver(const crypto::aes_t &key, const std::string &session_tag) {
+    return std::make_shared<receiver_t>(key, session_tag);
+  }
+
+  void activate(const std::shared_ptr<receiver_t> &r) {
+    if (!r) {
+      return;
+    }
+    {
+      std::lock_guard lg {r->lock};
+      if (r->running) {
+        return;
+      }
+      r->running = true;
+    }
+    r->writer = std::thread {[r]() {
+      r->run();
+    }};
+    std::lock_guard lg {registry_lock};
+    registry[r->session_tag] = r;
+    BOOST_LOG(info) << "clouddeck_mic: microphone stream active for session"sv;
+  }
+
+  void deactivate(const std::shared_ptr<receiver_t> &r) {
+    if (!r) {
+      return;
+    }
+    {
+      std::lock_guard lg {registry_lock};
+      auto it = registry.find(r->session_tag);
+      if (it != registry.end() && it->second == r) {
+        registry.erase(it);
+      }
+    }
+    {
+      std::lock_guard lg {r->lock};
+      r->running = false;
+      r->cv.notify_all();
+    }
+    if (r->writer.joinable()) {
+      r->writer.join();
+    }
+    BOOST_LOG(info) << "clouddeck_mic: microphone stream stopped ("sv << r->dropped << " packets dropped)"sv;
+  }
+
+  void dispatch(const char *data, std::size_t len) {
+    std::string tag {data + 4, 16};
+    std::shared_ptr<receiver_t> r;
+    {
+      std::lock_guard lg {registry_lock};
+      auto it = registry.find(tag);
+      if (it == registry.end()) {
+        return;  // no session with the mic enabled for this tag
+      }
+      r = it->second;
+    }
+    r->handle(std::string_view {data, len});
+  }
+}  // namespace clouddeck_mic
