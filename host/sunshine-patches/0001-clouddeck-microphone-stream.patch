+/**
+ * @file tests/unit/test_clouddeck_mic.cpp
+ * @brief Test src/clouddeck_mic.* (CloudDeck-Client microphone protocol v1).
+ *
+ * kVector1 is shared/fixtures/mic/vector1.hex from CloudDeck-Client, produced by the
+ * client encoder in moonlight-common-c. Decoding it here proves both sides agree.
+ */
+// test includes
+#include "../tests_common.h"
+
+#include <src/clouddeck_mic.h>
+
+namespace {
+  constexpr std::string_view kVector1 =
+    "8d01000030313233343536373839414243444546000000000000002a482827e507ee300f92a34956a7c03b46d5400f54feeee33985a58fdfedfe5021d2201248a8fb1800b11a";
+
+  std::string unhex(std::string_view h) {
+    std::string out;
+    for (std::size_t i = 0; i + 1 < h.size(); i += 2) {
+      out.push_back((char) std::stoi(std::string {h.substr(i, 2)}, nullptr, 16));
+    }
+    return out;
+  }
+
+  crypto::aes_t test_key() {
+    return {0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff};
+  }
+}  // namespace
+
+TEST(CloudDeckMicTest, DecodesSharedClientVector) {
+  crypto::cipher::gcm_t cipher {test_key(), false};
+  auto pkt = unhex(kVector1);
+  ASSERT_TRUE(clouddeck_mic::is_mic_packet(pkt.data(), pkt.size()));
+  auto d = clouddeck_mic::decode_packet(cipher, pkt);
+  ASSERT_TRUE(d.has_value());
+  EXPECT_EQ(d->seq, 42u);
+  EXPECT_EQ(d->rtp_ts, 40320u);
+  EXPECT_EQ(d->flags, 0u);
+  ASSERT_EQ(d->opus.size(), 20u);
+  for (int i = 0; i < 20; i++) {
+    EXPECT_EQ(d->opus[i], (std::uint8_t) (i * 7 + 3));
+  }
+  EXPECT_EQ(pkt.substr(4, 16), "0123456789ABCDEF");
+}
+
+TEST(CloudDeckMicTest, RejectsTamperedPackets) {
+  auto pkt = unhex(kVector1);
+  for (std::size_t pos : {std::size_t {1}, std::size_t {27}, std::size_t {30}, pkt.size() - 1}) {
+    crypto::cipher::gcm_t cipher {test_key(), false};
+    auto bad = pkt;
+    bad[pos] ^= 1;
+    EXPECT_FALSE(clouddeck_mic::decode_packet(cipher, bad).has_value()) << "byte " << pos;
+  }
+  crypto::aes_t wrong = test_key();
+  wrong[0] ^= 1;
+  crypto::cipher::gcm_t wrong_cipher {wrong, false};
+  EXPECT_FALSE(clouddeck_mic::decode_packet(wrong_cipher, pkt).has_value());
+  crypto::cipher::gcm_t cipher {test_key(), false};
+  EXPECT_FALSE(clouddeck_mic::decode_packet(cipher, pkt.substr(0, 40)).has_value());
+}
+
+TEST(CloudDeckMicTest, PingPayloadsAreNeverMicPackets) {
+  // Sunshine ping payloads are hex text; 0x8D can never be their first byte.
+  std::string ping = "0123456789ABCDEF";
+  ping.append(64, 'A');
+  EXPECT_FALSE(clouddeck_mic::is_mic_packet(ping.data(), ping.size()));
+}
+
+TEST(CloudDeckMicTest, NonceUsesClientMicDomain) {
+  auto iv = clouddeck_mic::nonce_for(0x0102030405060708ULL);
+  ASSERT_EQ(iv.size(), 12u);
+  EXPECT_EQ(iv[0], 0x08);
+  EXPECT_EQ(iv[7], 0x01);
+  EXPECT_EQ(iv[10], 'C');
+  EXPECT_EQ(iv[11], 'M');
+}
+
+TEST(CloudDeckMicTest, ReplayWindow) {
+  clouddeck_mic::replay_window_t w;
+  EXPECT_TRUE(w.accept(10));
+  EXPECT_FALSE(w.accept(10));  // duplicate
+  EXPECT_TRUE(w.accept(12));
+  EXPECT_TRUE(w.accept(11));  // late but inside window
+  EXPECT_FALSE(w.accept(11));
+  EXPECT_TRUE(w.accept(100));
+  EXPECT_FALSE(w.accept(36));  // 64 behind
+  EXPECT_TRUE(w.accept(37));  // 63 behind
+  EXPECT_TRUE(w.accept(1000));  // big jump resets the bitmap
+  EXPECT_FALSE(w.accept(100));
+}
