       session->audio.ping_payload = launch_session.av_ping_payload;
       session->audio.avRiKeyId = util::endian::big(*(std::uint32_t *) launch_session.iv.data());
+
+      // CloudDeck-Client: microphone receiver keyed with the session's GCM key
+      if (config.micEnabled && launch_session.av_ping_payload.size() == 16) {
+        BOOST_LOG(info) << "Microphone stream requested by client"sv;
+        session->mic = clouddeck_mic::make_receiver(launch_session.gcm_key, launch_session.av_ping_payload);
+      }
       session->audio.sequenceNumber = 0;
       session->audio.timestamp = 0;
 
