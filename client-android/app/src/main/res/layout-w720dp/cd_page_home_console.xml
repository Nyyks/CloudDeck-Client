<?xml version="1.0" encoding="utf-8"?>
<!-- Console layout, Home page on wide screens (tablets, handhelds in landscape, TVs). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cd_your_clouddeck"
                android:textColor="@color/cd_text"
                android:textSize="32sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/cd_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/cd_muted"
                android:textSize="14sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/cd_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/cd_bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="32dp">
        <Button
            android:id="@+id/cd_connect"
            android:layout_width="168dp"
            android:layout_height="168dp"
            android:background="@drawable/cd_bg_connect"
            android:drawableTop="@drawable/cd_ic_play"
            android:paddingTop="38dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:maxLines="2"
            android:stateListAnimator="@null"
            android:text="@string/cd_connect"
            android:textAllCaps="false"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/cd_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cd_text"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/cd_stream_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/cd_text2"
                android:textSize="15sp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">
                <Button android:id="@+id/cd_chip_mic" style="@style/CdChip" />
                <Button android:id="@+id/cd_chip_osc" style="@style/CdChip" android:text="@string/cd_chip_osc" />
            </LinearLayout>
            <include layout="@layout/cd_progress_block" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <LinearLayout android:id="@+id/cd_tile_power" style="@style/CdTile" android:layout_marginEnd="12dp">
            <TextView android:id="@+id/cd_tile_power_title" style="@style/CdTileTitle" android:drawableStart="@drawable/cd_ic_restart" />
            <TextView android:id="@+id/cd_tile_power_sub" style="@style/CdTileSub" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cd_tile_stop" style="@style/CdTile">
            <TextView style="@style/CdTileTitle" android:drawableStart="@drawable/cd_ic_power" android:text="@string/cd_stop" />
            <TextView style="@style/CdTileSub" android:text="@string/cd_tile_stop_sub" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <LinearLayout android:id="@+id/cd_tile_mic" style="@style/CdTile" android:layout_marginEnd="12dp">
            <TextView style="@style/CdTileTitle" android:drawableStart="@drawable/cd_ic_mic" android:text="@string/cd_card_mic" />
            <TextView android:id="@+id/cd_tile_mic_sub" style="@style/CdTileSub" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cd_tile_stream" style="@style/CdTile">
            <TextView style="@style/CdTileTitle" android:drawableStart="@drawable/cd_ic_tune" android:text="@string/cd_tile_resolution" />
            <TextView android:id="@+id/cd_tile_res_sub" style="@style/CdTileSub" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
