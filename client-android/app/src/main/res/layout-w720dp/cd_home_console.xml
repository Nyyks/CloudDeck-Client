<?xml version="1.0" encoding="utf-8"?>
<!-- Home layout A, "Console", on wide screens: sidebar with pages, the page on the right.
     D-pad left/right moves between sidebar and page. docs/adr/0013-home-layouts.md -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cd_bg"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="232dp"
        android:layout_height="match_parent"
        android:background="@color/cd_surface"
        android:orientation="vertical"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/cd_mark" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/cd_title"
                android:textColor="@color/cd_text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
        <Button android:id="@+id/cd_nav_home" style="@style/CdNav" android:drawableStart="@drawable/cd_ic_home" android:text="@string/cd_nav_home" />
        <Button android:id="@+id/cd_nav_stream" style="@style/CdNav" android:drawableStart="@drawable/cd_ic_stream" android:text="@string/cd_nav_stream" />
        <Button android:id="@+id/cd_nav_devices" style="@style/CdNav" android:drawableStart="@drawable/cd_ic_devices" android:text="@string/cd_nav_devices" />
        <Button android:id="@+id/cd_nav_account" style="@style/CdNav" android:drawableStart="@drawable/cd_ic_account" android:text="@string/cd_nav_account" />
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/cd_bg_account"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:id="@+id/cd_side_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/cd_text"
                android:textSize="13sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/cd_side_signout"
                style="@style/CdButton.Link"
                android:layout_marginStart="-12dp"
                android:minHeight="40dp"
                android:text="@string/cd_sign_out" />
        </LinearLayout>
    </LinearLayout>
    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/cd_border" />

    <ScrollView
        android:id="@+id/cd_content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingTop="32dp"
            android:paddingEnd="40dp"
            android:paddingBottom="24dp">
            <TextView
                android:id="@+id/cd_page_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:textColor="@color/cd_text"
                android:textSize="28sp"
                android:textStyle="bold"
                android:visibility="gone" />
            <include android:id="@+id/cd_page_home" layout="@layout/cd_page_home_console" />
            <include android:id="@+id/cd_page_stream" layout="@layout/cd_section_stream" android:visibility="gone" />
            <include android:id="@+id/cd_page_devices" layout="@layout/cd_section_devices" android:visibility="gone" />
            <include android:id="@+id/cd_page_account" layout="@layout/cd_section_account" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
