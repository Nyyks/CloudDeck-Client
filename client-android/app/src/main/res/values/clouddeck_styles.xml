<?xml version="1.0" encoding="utf-8"?>
<!-- CloudDeck-Client home screen styles (Phase 7, docs/adr/0013-home-layouts.md).
     Every interactive style has a visible focus state for D-pad, gamepad and TV remotes,
     and at least 48dp of touch height. -->
<resources>
    <style name="CdTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/cd_bg</item>
        <item name="android:colorAccent">@color/cd_accent</item>
        <item name="android:colorControlActivated">@color/cd_accent</item>
        <item name="android:statusBarColor">@color/cd_bg</item>
        <item name="android:navigationBarColor">@color/cd_bg</item>
        <item name="android:textColorPrimary">@color/cd_text</item>
        <item name="android:textColorSecondary">@color/cd_muted</item>
    </style>

    <style name="CdCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/cd_bg_card</item>
    </style>
    <style name="CdCardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/cd_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="CdHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/cd_muted</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="CdBody" parent="CdHint">
        <item name="android:textColor">@color/cd_text</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="CdSwitchRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/cd_bg_row</item>
        <item name="android:textColor">@color/cd_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:switchPadding">16dp</item>
    </style>

    <style name="CdButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/cd_text</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/cd_bg_secondary</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="CdButton.Primary">
        <item name="android:background">@drawable/cd_bg_primary</item>
        <item name="android:textColor">#ffffff</item>
    </style>
    <style name="CdButton.Ghost">
        <item name="android:background">@drawable/cd_bg_ghost</item>
    </style>
    <style name="CdButton.Link">
        <item name="android:background">@drawable/cd_bg_ghost</item>
        <item name="android:textColor">@color/cd_accent_text</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <style name="CdChip" parent="CdButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/cd_chip_text</item>
        <item name="android:background">@drawable/cd_bg_chip</item>
    </style>
    <style name="CdNav" parent="CdButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/cd_nav_text</item>
        <item name="android:background">@drawable/cd_bg_nav</item>
    </style>
    <style name="CdNav.Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginBottom">0dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:background">@drawable/cd_bg_nav_chip</item>
    </style>
    <style name="CdSegment" parent="CdButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/cd_nav_text</item>
        <item name="android:background">@drawable/cd_bg_segment</item>
    </style>
    <style name="CdSegmentTrack">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">4dp</item>
        <item name="android:background">@drawable/cd_bg_segment_track</item>
    </style>
    <style name="CdTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">84dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/cd_bg_tile</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="CdTileTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/cd_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:duplicateParentState">true</item>
    </style>
    <style name="CdTileSub">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/cd_tile_sub</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:duplicateParentState">true</item>
    </style>
</resources>
