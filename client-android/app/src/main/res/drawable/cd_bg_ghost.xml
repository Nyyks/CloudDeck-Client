<?xml version="1.0" encoding="utf-8"?>
<!-- CloudDeck-Client (docs/adr/0013-home-layouts.md): focused = 3dp ring for D-pad, gamepad and TV remotes. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
        <item android:state_enabled="false"><shape android:shape="rectangle"><corners android:radius="12dp"/><solid android:color="#00000000"/></shape></item>
        <item android:state_pressed="true"><shape android:shape="rectangle"><corners android:radius="12dp"/><solid android:color="#2b3240"/></shape></item>
        <item android:state_focused="true"><shape android:shape="rectangle"><corners android:radius="12dp"/><solid android:color="#00000000"/><stroke android:width="3dp" android:color="#9db4ff"/></shape></item>
        <item><shape android:shape="rectangle"><corners android:radius="12dp"/><solid android:color="#00000000"/></shape></item>
</selector>
