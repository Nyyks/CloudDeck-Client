<?xml version="1.0" encoding="utf-8"?>
<!-- CloudDeck-Client (docs/adr/0013-home-layouts.md): focused = 3dp ring for D-pad, gamepad and TV remotes. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
        <item android:state_enabled="false"><shape android:shape="rectangle"><corners android:radius="10dp"/><solid android:color="#00000000"/><stroke android:width="1dp" android:color="#2a2f39"/></shape></item>
        <item android:state_pressed="true"><shape android:shape="rectangle"><corners android:radius="10dp"/><solid android:color="#2b3240"/></shape></item>
        <item android:state_focused="true" android:state_selected="true"><shape android:shape="rectangle"><corners android:radius="10dp"/><solid android:color="#1f2430"/><stroke android:width="3dp" android:color="#9db4ff"/></shape></item>
        <item android:state_selected="true"><shape android:shape="rectangle"><corners android:radius="10dp"/><solid android:color="#1f2430"/></shape></item>
        <item android:state_focused="true"><shape android:shape="rectangle"><corners android:radius="10dp"/><solid android:color="#00000000"/><stroke android:width="3dp" android:color="#9db4ff"/></shape></item>
        <item><shape android:shape="rectangle"><corners android:radius="10dp"/><solid android:color="#00000000"/><stroke android:width="1dp" android:color="#2a2f39"/></shape></item>
</selector>
