<?xml version="1.0" encoding="utf-8"?>
<!-- Home layout C, "Launcher": the mark, one big "Start and connect" pill, quick chips, and a
     settings panel sliding in from the side (full width on phones). Back or B closes the panel;
     Menu or Start opens it. docs/adr/0013-home-layouts.md -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cd_bg_launcher">

    <LinearLayout
        android:id="@+id/cd_launcher_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/cd_top_email"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/cd_muted"
                android:textSize="13sp" />
            <Button
                android:id="@+id/cd_settings"
                style="@style/CdButton.Ghost"
                android:drawableStart="@drawable/cd_ic_gear"
                android:drawablePadding="10dp"
                android:text="@string/cd_settings" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">
                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@null"
                    android:src="@drawable/cd_mark" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/cd_your_clouddeck"
                    android:textColor="#f1f3f6"
                    android:textSize="32sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/cd_status_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/cd_muted"
                    android:textSize="15sp" />
                <Button
                    android:id="@+id/cd_connect"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="24dp"
                    android:maxWidth="320dp"
                    android:background="@drawable/cd_bg_pill"
                    android:drawableStart="@drawable/cd_ic_play_dark"
                    android:paddingStart="28dp"
                    android:paddingEnd="44dp"
                    android:stateListAnimator="@null"
                    android:text="@string/cd_start_and_connect"
                    android:textAllCaps="false"
                    android:textColor="@color/cd_launcher_accent_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">
                    <Button android:id="@+id/cd_chip_mic" style="@style/CdChip" />
                    <Button android:id="@+id/cd_chip_osc" style="@style/CdChip" android:text="@string/cd_chip_osc" />
                    <Button android:id="@+id/cd_chip_nintendo" style="@style/CdChip" android:layout_marginEnd="0dp" android:text="@string/cd_chip_nintendo" />
                </LinearLayout>
                <include layout="@layout/cd_progress_block" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">
            <Button android:id="@+id/cd_link_power" style="@style/CdButton.Link" />
            <Button android:id="@+id/cd_link_stop" style="@style/CdButton.Link" android:text="@string/cd_stop" />
            <Button android:id="@+id/cd_link_pcs" style="@style/CdButton.Link" android:text="@string/cd_manage_pcs" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/cd_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cd_scrim"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/cd_drawer"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/cd_drawer"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:text="@string/cd_settings"
                android:textColor="@color/cd_text"
                android:textSize="20sp"
                android:textStyle="bold" />
            <ImageButton
                android:id="@+id/cd_drawer_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/cd_bg_ghost"
                android:contentDescription="@string/cd_close"
                android:src="@drawable/cd_ic_close" />
        </LinearLayout>
        <LinearLayout style="@style/CdSegmentTrack" android:layout_marginTop="12dp" android:layout_marginBottom="12dp">
            <Button android:id="@+id/cd_tab_stream" style="@style/CdSegment" android:text="@string/cd_nav_stream" />
            <Button android:id="@+id/cd_tab_devices" style="@style/CdSegment" android:text="@string/cd_nav_devices" />
            <Button android:id="@+id/cd_tab_account" style="@style/CdSegment" android:text="@string/cd_nav_account" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
        <ScrollView
            android:id="@+id/cd_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <include android:id="@+id/cd_page_devices" layout="@layout/cd_section_devices" />
                <include android:id="@+id/cd_page_account" layout="@layout/cd_section_account" android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
        <FrameLayout
            android:id="@+id/cd_prefs_host"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
