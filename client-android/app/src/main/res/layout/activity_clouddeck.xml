<?xml version="1.0" encoding="utf-8"?>
<!-- CloudDeck-Client home screen: sign-in, then the home layout picked in the settings
     (cd_home_console.xml or cd_home_launcher.xml, inflated into cd_home).
     docs/adr/0013-home-layouts.md -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cd_bg">

    <!-- restoring -->
    <LinearLayout
        android:id="@+id/cd_restoring"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">
        <ProgressBar android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/cd_signing_in"
            android:textColor="@color/cd_text"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- sign-in -->
    <ScrollView
        android:id="@+id/cd_signin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">
            <LinearLayout
                android:id="@+id/cd_signin_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/cd_bg_signin_card"
                android:orientation="vertical"
                android:padding="28dp">
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:src="@drawable/cd_mark" />
                <TextView
                    android:id="@+id/cd_signin_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/cd_sign_in_title"
                    android:textColor="@color/cd_text"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/cd_signin_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/cd_muted"
                    android:textSize="14sp" />
                <EditText
                    android:id="@+id/cd_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:autofillHints="emailAddress"
                    android:hint="@string/cd_email"
                    android:inputType="textEmailAddress"
                    android:minHeight="52dp"
                    android:textColor="@color/cd_text"
                    android:textColorHint="@color/cd_muted" />
                <EditText
                    android:id="@+id/cd_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="password"
                    android:hint="@string/cd_password"
                    android:imeOptions="actionGo"
                    android:inputType="textPassword"
                    android:minHeight="52dp"
                    android:textColor="@color/cd_text"
                    android:textColorHint="@color/cd_muted" />
                <EditText
                    android:id="@+id/cd_mfa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/cd_mfa_code"
                    android:imeOptions="actionGo"
                    android:inputType="number"
                    android:minHeight="52dp"
                    android:textColor="@color/cd_text"
                    android:textColorHint="@color/cd_muted"
                    android:visibility="gone" />
                <Button
                    android:id="@+id/cd_signin_button"
                    style="@style/CdButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_marginTop="12dp"
                    android:minHeight="52dp"
                    android:text="@string/cd_sign_in" />
                <TextView
                    android:id="@+id/cd_signin_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/cd_error"
                    android:visibility="gone" />
                <Button
                    android:id="@+id/cd_signin_pcs"
                    style="@style/CdButton.Link"
                    android:layout_marginStart="-12dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/cd_use_other_host" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>

    <!-- home (layout from the settings) -->
    <FrameLayout
        android:id="@+id/cd_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
