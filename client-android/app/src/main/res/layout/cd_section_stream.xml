<?xml version="1.0" encoding="utf-8"?>
<!-- CloudDeck settings section "Stream" (both home layouts, docs/adr/0013-home-layouts.md). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout style="@style/CdCard">
        <TextView style="@style/CdCardTitle" android:text="@string/cd_card_quality" />
        <TextView android:id="@+id/cd_stream_summary" style="@style/CdBody" />
        <TextView style="@style/CdHint" android:text="@string/cd_quality_hint" />
        <Button
            android:id="@+id/cd_stream_settings"
            style="@style/CdButton"
            android:layout_marginStart="14dp"
            android:layout_marginBottom="8dp"
            android:text="@string/cd_all_stream_settings" />
    </LinearLayout>

    <LinearLayout style="@style/CdCard">
        <TextView style="@style/CdCardTitle" android:text="@string/cd_card_vm" />
        <Switch android:id="@+id/cd_autostop" style="@style/CdSwitchRow" android:text="@string/cd_auto_stop" />
        <TextView style="@style/CdHint" android:text="@string/cd_auto_stop_hint" />
    </LinearLayout>
</LinearLayout>
